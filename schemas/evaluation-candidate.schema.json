{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qacraft.dev/schemas/evaluation-candidate.schema.json",
  "title": "QACraft Evaluation Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "run_id",
    "generated_at",
    "source_references",
    "context_hash",
    "approvals",
    "claims",
    "evidence",
    "results",
    "findings",
    "decision",
    "safety",
    "outputs",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill": {
      "enum": [
        "feature-qa",
        "ticket-review",
        "bug-report",
        "verify-fix",
        "release-qa",
        "test-plan",
        "regression-scope",
        "customer-issue-repro",
        "api-qa",
        "staged-rollout-check"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_hash": {
      "$ref": "#/$defs/hash"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gate",
        "approver",
        "role",
        "approved_at",
        "expires_at",
        "context_hash",
        "document_hash",
        "valid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "context_hash": {
          "$ref": "#/$defs/hash"
        },
        "document_hash": {
          "$ref": "#/$defs/hash"
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "classification",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "observed",
            "inference",
            "uncertainty"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source_reference",
        "captured_at",
        "integrity_hash",
        "privacy_reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "integrity_hash": {
          "$ref": "#/$defs/hash"
        },
        "privacy_reviewed": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "status",
        "expected",
        "actual",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "INCONCLUSIVE",
            "NOT TESTED",
            "FLAKY"
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "release_blocking",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted"
          ]
        },
        "release_blocking": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason",
        "evidence_ids"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "external_write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "approved",
        "idempotency_key"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission_scope_verified",
        "secrets_in_output",
        "personal_data_in_output",
        "external_writes",
        "accepted_risks",
        "assumptions",
        "uncertainties"
      ],
      "properties": {
        "permission_scope_verified": {
          "type": "boolean"
        },
        "secrets_in_output": {
          "type": "boolean"
        },
        "personal_data_in_output": {
          "type": "boolean"
        },
        "external_writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external_write"
          }
        },
        "accepted_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "residual_resources"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "not-required",
            "blocked"
          ]
        },
        "residual_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
