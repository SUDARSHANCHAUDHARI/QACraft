{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/finding.schema.json",
  "title": "QA Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "run_id",
    "title",
    "classification",
    "confidence",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "finding_id": {
      "type": "string",
      "minLength": 8
    },
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE",
        "UNKNOWN"
      ]
    },
    "release_blocking": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "CONFIRMED",
        "REJECTED",
        "DUPLICATE_CANDIDATE",
        "PUBLISHED",
        "RESOLVED"
      ]
    },
    "expected": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "actual": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "candidate_duplicates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
